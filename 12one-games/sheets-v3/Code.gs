let x=auth_(s,a,q,["player"]),p=g.players.find(y=>y.id===x.id);check_(p,"Player no longer registered.");if(act==="playerRead")return view_(r,g,p,now);if(act==="verify"){s.rate("verify:"+code+":"+p.id);check_(actions_(g,r.type),"Actions unavailable.");target_(g,r.type,p,q.kind,q.target);return {verified:true,verifiedAt:now,proof:s.hash(JSON.stringify([x.hash,code,p.id,q.kind,norm_(q.target),now]))};}if(act==="play"){let id=str_(q.requestId,1,100),old=g.receipts.find(y=>y.id===id&&y.player===p.id);if(old)return old.result;if(q.kind!=="retract"){check_(Number.isInteger(q.verifiedAt)&&q.verifiedAt<=now&&q.verifiedAt>=now-120000&&eq_(q.proof,s.hash(JSON.stringify([x.hash,code,p.id,q.kind,norm_(q.target),q.verifiedAt]))),"Verify the target again.");}let result=play_(g,r.type,p,q.kind,q.target,now);g.receipts.push({id,player:p.id,result});g.receipts=g.receipts.slice(-500);persist();return result;}check_(false,"Unsupported action.");
}
// Workbook adapter
const AL_=[["hosts",1,"id name email enabled salt hash"],["invites",8,"id hash credits expires redeemedBy redeemedAt revoked created"],["games",17,"code type name owner created archived deleted requestId"],["sessions",26,"hash kind id game expires"],["settings",32,"key value"],["defaults",35,"key value"],["audit",38,"time type actor details"]];
const GL_=[["players",1,"id name codename hall phone salt hash role alive target kills last vote result"],["settings",16,"key value"],["state",19,"key value"],["log",22,"time type actor target details publicText"],["receipts",29,"id player result"]];
function props_(){return PropertiesService.getScriptProperties();}
function book_(){return SpreadsheetApp.openById(props_().getProperty("WORKBOOK_ID"));}
function id_(){return Utilities.getUuid().replace(/-/g,"");}
function hash_(v){return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(String(v),props_().getProperty("AUTH_PEPPER")));}
function width_(l){return Math.max(...l.map(([n,c,f])=>c+f.split(" ").length-1));}
function format_(sh,l){let w=width_(l);if(sh.getMaxColumns()<w)sh.insertColumnsAfter(sh.getMaxColumns(),w-sh.getMaxColumns());for(let [n,c,f] of l){let fields=f.split(" ");sh.getRange(1,c,1,fields.length).merge().setValue(n.toUpperCase()).setBackground("#9b2226").setFontColor("#ffffff").setFontWeight("bold");sh.getRange(2,c,1,fields.length).setValues([fields]).setBackground("#e9d8a6").setFontWeight("bold");sh.setColumnWidths(c,fields.length,135);}sh.setFrozenRows(2);}
function pack_(v){if(v===null||v===undefined)return "";if(typeof v==="object")return JSON.stringify(v);if(typeof v==="string")return "'"+v;return v;}
function keyed_(n){return ["settings","defaults","state"].includes(n);}
function read_(sh,l){let n=sh.getLastRow()-2,rows=n>0?sh.getRange(3,1,n,width_(l)).getValues():[],out={};for(let [key,c,f] of l){let fields=f.split(" "),rs=rows.filter(r=>r[c-1]!=="").map(r=>Object.fromEntries(fields.map((k,i)=>{let v=r[c-1+i];if(["last","vote","result"].includes(k))v=v===""?null:JSON.parse(v);return [k,v];})));out[key]=keyed_(key)?Object.fromEntries(rs.map(r=>[r.key,key==="defaults"?JSON.parse(r.value):r.value])):rs;}return out;}
function write_(sh,l,o){let blocks=l.map(([k,c,f])=>({c,f:f.split(" "),rs:keyed_(k)?Object.entries(o[k]).map(([key,value])=>({key,value})):o[k]})),n=Math.max(1,sh.getLastRow()-2,...blocks.map(b=>b.rs.length));if(sh.getMaxRows()<n+2)sh.insertRowsAfter(sh.getMaxRows(),n+2-sh.getMaxRows());let rows=Array.from({length:n},()=>Array(width_(l)).fill(""));for(let b of blocks)b.rs.forEach((r,i)=>b.f.forEach((k,j)=>rows[i][b.c-1+j]=pack_(r[k])));sh.getRange(3,1,n,width_(l)).setValues(rows);}
function initializeWorkbook_(){let lock=LockService.getScriptLock();lock.waitLock(30000);try{let b=SpreadsheetApp.getActiveSpreadsheet(),p=props_();if(!b)throw Error("Run from bound spreadsheet.");if(p.getProperty("WORKBOOK_ID")&&p.getProperty("WORKBOOK_ID")!==b.getId())throw Error("Workbook mismatch.");p.setProperty("WORKBOOK_ID",b.getId());if(!p.getProperty("AUTH_PEPPER"))p.setProperty("AUTH_PEPPER",id_()+id_());if(!b.getSheetByName("_ADMIN")){let sh=b.insertSheet("_ADMIN");format_(sh,AL_);write_(sh,AL_,newAdmin_());}if(!p.getProperty("ADMIN_CREDENTIAL")){let pw=password_(p.getProperty("INITIAL_ADMIN_PASSWORD"));p.setProperty("ADMIN_CREDENTIAL",JSON.stringify(credential_({id:id_,hash:hash_},pw)));p.deleteProperty("INITIAL_ADMIN_PASSWORD");}}finally{SpreadsheetApp.flush();lock.releaseLock();}}
function recoverAdministrator_(){let lock=LockService.getScriptLock();lock.waitLock(30000);try{let p=props_(),pw=password_(p.getProperty("RECOVERY_ADMIN_PASSWORD"));p.setProperty("ADMIN_CREDENTIAL",JSON.stringify(credential_({id:id_,hash:hash_},pw)));p.deleteProperty("RECOVERY_ADMIN_PASSWORD");let sh=book_().getSheetByName("_ADMIN"),a=read_(sh,AL_);a.sessions=a.sessions.filter(x=>x.kind!=="admin");write_(sh,AL_,a);}finally{SpreadsheetApp.flush();lock.releaseLock();}}
function store_(){let b=book_(),ad=b.getSheetByName("_ADMIN"),cache=CacheService.getScriptCache();return {now:Date.now,id:id_,hash:hash_,random:Math.random,adminCredential:()=>JSON.parse(props_().getProperty("ADMIN_CREDENTIAL")),rate:k=>{let key="rate_"+hash_(k),n=Number(cache.get(key)||0);check_(n<12,"Too many attempts; retry in 10 minutes.");cache.put(key,String(n+1),600);},readAdmin:()=>read_(ad,AL_),writeAdmin:a=>write_(ad,AL_,a),exists:c=>!!b.getSheetByName(c),readGame:c=>{let sh=b.getSheetByName(c);return sh?read_(sh,GL_):null;},writeGame:(c,g)=>write_(b.getSheetByName(c),GL_,g),createGame:(c,g)=>{let sh=b.insertSheet(c);format_(sh,GL_);write_(sh,GL_,g);},removeGame:c=>{let sh=b.getSheetByName(c);if(sh&&/^(ASSASSINS|MAFIA)\d{6}$/.test(c))b.deleteSheet(sh);}};}
function json_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON);}
function initializeWorkbook(){return initializeWorkbook_();}
function recoverAdministrator(){return recoverAdministrator_();}
function doGet(){return json_({ok:true,service:"12one Games Sheets",version:"3-development"});}
function doPost(e){let lock;try{check_(e&&e.postData&&e.postData.contents.length<=40000,"Invalid request.");let q=JSON.parse(e.postData.contents);lock=LockService.getScriptLock();check_(lock.tryLock(20000),"Server busy; retry.");let data=dispatch_(store_(),q);SpreadsheetApp.flush();return json_({ok:true,data});}catch(err){if(!err.safe)console.error(err.name);return json_({ok:false,error:err.safe?err.message:"Request failed. Refresh before retrying."});}finally{if(lock&&lock.hasLock())lock.releaseLock();}}
